// Four grass cells. 'k' and 'l' are a sound pair landing on (1, 0) and (2, 0): the map has a
// linked portal, so it must be reached from the entry, and nothing leads here.
(
    schema: 1, id: "reach:map:foot", name: "reach:text:foot", kind: Outdoor, tileset: "test:tileset:outdoor",
    width: 4, height: 1, start: (0, 0, East),
    wall: (front: "hedge", left: "hedge.left", right: "hedge.right"), door: "gate", door_open: Some("gate.open"),
    terrains: [
        (glyph: 'g', name: "grass", floor: "grass", ceiling: None, passable: true, visibility_depth: 6, step_minutes: 2),
    ],
    layout: ["+-+-+-+-+", "|g g g g|", "+-+-+-+-+"],
    portals: [
        (x: 0, y: 0, id: "k", link: Some("l"), facing: East, marker: Some("signpost")),
        (x: 3, y: 0, id: "l", facing: West, marker: Some("signpost")),
    ],
)
