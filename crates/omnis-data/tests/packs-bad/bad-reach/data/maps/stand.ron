// The entry map: two grass cells and no portal at all.
(
    schema: 1, id: "reach:map:stand", name: "reach:text:stand", kind: Outdoor, tileset: "test:tileset:outdoor",
    width: 2, height: 1, start: (0, 0, East),
    wall: (front: "hedge", left: "hedge.left", right: "hedge.right"), door: "gate", door_open: Some("gate.open"),
    terrains: [
        (glyph: 'g', name: "grass", floor: "grass", ceiling: None, passable: true, visibility_depth: 6, step_minutes: 2),
    ],
    layout: ["+-+-+", "|g g|", "+-+-+"],
)
