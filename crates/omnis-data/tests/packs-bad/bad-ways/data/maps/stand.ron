// Twelve cells in a row: grass, rock, no ground, then grass. The start is on no ground. The
// portals (W1 step 2, links): 'a' links to nothing loaded; 'b' and 'c' are a pair whose landings
// are the rock and the no-ground cell; 'd' links to 'e', which links to 'f', so 'e' has two
// claimants and 'f' lands where 'd' stands; 'i' is linked to 'h' at the east edge, whose landing
// is outside; 'g' links to itself; 'dup' shares its id with a portal of foot.ron.
(
    schema: 1, id: "ways:map:stand", name: "ways:text:stand", kind: Outdoor, tileset: "test:tileset:outdoor",
    width: 12, height: 1, start: (2, 0, North),
    wall: (front: "hedge", left: "hedge.left", right: "hedge.right"), door: "gate", door_open: Some("gate.open"),
    terrains: [
        (glyph: 'g', name: "grass", floor: "grass", ceiling: None, passable: true, visibility_depth: 6, step_minutes: 2),
        (glyph: 'r', name: "rock", floor: "grass", ceiling: None, block: Some("trees"), passable: false, visibility_depth: 6, step_minutes: 2),
    ],
    layout: ["+-+-+-+-+-+-+-+-+-+-+-+-+", "|g r _ g g g g g g g g g|", "+-+-+-+-+-+-+-+-+-+-+-+-+"],
    portals: [
        (x: 0, y: 0, id: "a", link: Some("gone"), facing: East, marker: Some("signpost")),
        (x: 0, y: 0, id: "b", facing: East, marker: Some("signpost")),
        (x: 3, y: 0, id: "c", link: Some("b"), facing: West, marker: Some("signpost")),
        (x: 4, y: 0, id: "d", link: Some("e"), facing: East, marker: Some("signpost")),
        (x: 5, y: 0, id: "e", link: Some("f"), facing: West, marker: Some("signpost")),
        (x: 6, y: 0, id: "f", facing: West, marker: Some("signpost")),
        (x: 8, y: 0, id: "i", link: Some("h"), facing: West, marker: Some("signpost")),
        (x: 9, y: 0, id: "g", link: Some("g"), facing: West, marker: Some("signpost")),
        (x: 10, y: 0, id: "dup", facing: East, marker: Some("signpost")),
        (x: 11, y: 0, id: "h", facing: East, marker: Some("signpost")),
    ],
)
