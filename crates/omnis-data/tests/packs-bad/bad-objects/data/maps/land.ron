// A portal linked to refs.ron's 'refs-out' at (0, 1), which faces north: the landing is refs.ron's
// start (0, 0), where the box 'squat' stands across the centre. The pair itself is sound.
(
    schema: 1, id: "bado:map:land", name: "bado:text:map", kind: Outdoor, tileset: "test:tileset:outdoor",
    width: 2, height: 1, start: (1, 0, West),
    wall: (front: "hedge", left: "hedge.left", right: "hedge.right"), door: "gate", door_open: Some("gate.open"),
    terrains: [(glyph: 'g', name: "grass", floor: "grass", ceiling: None, passable: true, visibility_depth: 6, step_minutes: 2)],
    layout: ["+-+-+", "|g g|", "+-+-+"],
    portals: [(x: 0, y: 0, id: "land-in", link: Some("refs-out"), facing: East, marker: Some("signpost"))],
)
