(
    schema: 1, id: "bado:map:land", name: "bado:text:map", kind: Outdoor, tileset: "test:tileset:outdoor",
    width: 2, height: 1, start: (1, 0, West),
    wall: (front: "hedge", left: "hedge.left", right: "hedge.right"), door: "gate", door_open: Some("gate.open"),
