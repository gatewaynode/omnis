// English strings for the base pack's spell content. Keys are `base:text:spell.<name>.<field>`.
(
    schema: 1,
    entries: {
        "base:text:spell.acid_arrow.description": "A ranged spell attack: 4d4 acid damage on a hit, then 2d4 more at the end of the target's next turn; half the first on a miss.",
        "base:text:spell.acid_arrow.name": "Acid Arrow",
        "base:text:spell.bless.description": "Up to three creatures add 1d4 to attack rolls and saving throws for a minute.",
        "base:text:spell.bless.name": "Bless",
        "base:text:spell.burning_hands.description": "A 15-foot cone of flame: 3d6 fire damage, half on a successful Dexterity save; +1d6 per level above 1st.",
        "base:text:spell.burning_hands.name": "Burning Hands",
        "base:text:spell.cure_wounds.description": "A touched creature regains 1d8 + your casting modifier hit points; +1d8 per level above 1st.",
        "base:text:spell.cure_wounds.name": "Cure Wounds",
        "base:text:spell.fire_bolt.description": "A ranged spell attack for 1d10 fire damage; 2d10 at level 5, 3d10 at 11, 4d10 at 17.",
        "base:text:spell.fire_bolt.name": "Fire Bolt",
        "base:text:spell.guidance.description": "A willing creature adds 1d4 to one ability check within the next minute.",
        "base:text:spell.guidance.name": "Guidance",
        "base:text:spell.guiding_bolt.description": "A ranged spell attack: 4d6 radiant damage, and the next attack against the target has advantage; +1d6 per level above 1st.",
        "base:text:spell.guiding_bolt.name": "Guiding Bolt",
        "base:text:spell.healing_word.description": "A bonus action: a creature you can see regains 1d4 + your casting modifier hit points; +1d4 per level above 1st.",
        "base:text:spell.healing_word.name": "Healing Word",
        "base:text:spell.inflict_wounds.description": "A melee spell attack: 3d10 necrotic damage on a hit; +1d10 per level above 1st.",
        "base:text:spell.inflict_wounds.name": "Inflict Wounds",
        "base:text:spell.light.description": "An object sheds bright light in a 20-foot radius and dim light 20 feet beyond for an hour.",
        "base:text:spell.light.name": "Light",
        "base:text:spell.mage_hand.description": "A spectral hand manipulates objects up to 10 pounds within 30 feet for a minute.",
        "base:text:spell.mage_hand.name": "Mage Hand",
        "base:text:spell.magic_missile.description": "Three darts of force hit chosen targets for 1d4 + 1 force damage each; one more dart per level above 1st.",
        "base:text:spell.magic_missile.name": "Magic Missile",
        "base:text:spell.prayer_of_healing.description": "Up to six creatures each regain 2d8 + your spellcasting modifier hit points; a ten-minute prayer.",
        "base:text:spell.prayer_of_healing.name": "Prayer of Healing",
        "base:text:spell.sacred_flame.description": "Radiance descends on a creature; it takes 1d8 radiant damage unless it succeeds on a Dexterity save. Scales like Fire Bolt.",
        "base:text:spell.sacred_flame.name": "Sacred Flame",
        "base:text:spell.shatter.description": "A ringing burst in a 10-foot sphere: 3d8 thunder damage, half on a successful Constitution save; +1d8 per level above 2nd.",
        "base:text:spell.shatter.name": "Shatter",
        "base:text:spell.shield.description": "A reaction when hit: +5 to AC until your next turn and no damage from Magic Missile.",
        "base:text:spell.shield.name": "Shield",
        "base:text:spell.spiritual_weapon.description": "A floating spectral weapon makes a melee spell attack for 1d8 + your spellcasting modifier force damage, and again as a bonus action each turn for a minute.",
        "base:text:spell.spiritual_weapon.name": "Spiritual Weapon",
        "base:text:spell.thunderwave.description": "A wave of force in a 15-foot cube: 2d8 thunder damage and a 10-foot push, half and no push on a successful Constitution save; +1d8 per level above 1st.",
        "base:text:spell.thunderwave.name": "Thunderwave",
    },
)
