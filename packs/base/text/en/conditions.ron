// English strings for the base pack's condition content. Keys are `base:text:condition.<name>.<field>`.
(
    schema: 1,
    entries: {
        "base:text:condition.blinded.description": "Cannot see; fails sight checks; attacks against it have advantage and its own have disadvantage.",
        "base:text:condition.blinded.name": "Blinded",
        "base:text:condition.charmed.description": "Cannot attack the charmer, who has advantage on social checks against it.",
        "base:text:condition.charmed.name": "Charmed",
        "base:text:condition.dead.description": "Dead. A temple can raise them, unless the game was started with permadeath.",
        "base:text:condition.dead.name": "Dead",
        "base:text:condition.deafened.description": "Cannot hear; fails hearing checks.",
        "base:text:condition.deafened.name": "Deafened",
        "base:text:condition.exhaustion.description": "Six levels of mounting penalties from disadvantage on checks to death.",
        "base:text:condition.exhaustion.name": "Exhaustion",
        "base:text:condition.frightened.description": "Disadvantage on checks and attacks while the source is in sight; cannot approach it.",
        "base:text:condition.frightened.name": "Frightened",
        "base:text:condition.grappled.description": "Speed is zero until the grapple ends.",
        "base:text:condition.grappled.name": "Grappled",
        "base:text:condition.incapacitated.description": "Cannot take actions or reactions.",
        "base:text:condition.incapacitated.name": "Incapacitated",
        "base:text:condition.invisible.description": "Cannot be seen; attacks against it have disadvantage and its own have advantage.",
        "base:text:condition.invisible.name": "Invisible",
        "base:text:condition.paralyzed.description": "Incapacitated and cannot move or speak; fails Strength and Dexterity saves; melee hits are critical.",
        "base:text:condition.paralyzed.name": "Paralyzed",
        "base:text:condition.petrified.description": "Turned to stone: incapacitated, unaware, resistant to all damage, immune to poison and disease.",
        "base:text:condition.petrified.name": "Petrified",
        "base:text:condition.poisoned.description": "Disadvantage on attack rolls and ability checks.",
        "base:text:condition.poisoned.name": "Poisoned",
        "base:text:condition.prone.description": "Disadvantage on attacks; melee attacks against it have advantage, ranged ones disadvantage.",
        "base:text:condition.prone.name": "Prone",
        "base:text:condition.restrained.description": "Speed is zero; attacks against it have advantage, its own and its Dexterity saves disadvantage.",
        "base:text:condition.restrained.name": "Restrained",
        "base:text:condition.stunned.description": "Incapacitated, cannot move, speaks falteringly; fails Strength and Dexterity saves; attacks against it have advantage.",
        "base:text:condition.stunned.name": "Stunned",
        "base:text:condition.unconscious.description": "Incapacitated, prone, unaware; fails Strength and Dexterity saves; melee hits are critical.",
        "base:text:condition.unconscious.name": "Unconscious",
    },
)
