// The base content pack: SRD 5.1 material re-expressed in Omnis's own format (PRD §8, §11.2).
// Data files start with `schema`; ids are `base:<type>:<name>`; every display string is a key
// into text/<lang>/.
(
    schema: 1,
    id: "base",
    version: "0.1.0",
    name: "Omnis base content",
    license: "CC-BY-4.0",
    attribution: [
        ("System Reference Document 5.1 by Wizards of the Coast LLC", "CC-BY-4.0", "This work includes material taken from the System Reference Document 5.1 (\"SRD 5.1\") by Wizards of the Coast LLC and available at https://dnd.wizards.com/resources/systems-reference-document. The SRD 5.1 is licensed under the Creative Commons Attribution 4.0 International License available at https://creativecommons.org/licenses/by/4.0/legalcode."),
    ],
    depends: [],
)
