// SRD 5.1 Rogue (docs/dnd.srd.5.1/02_Classes). Starting equipment is the first option of
// each SRD line; packs of gear are not itemised yet. Prepared casters get a fixed number of
// spells per level (PRD §8.3), so `spells_at_1` stands in for "Wisdom modifier + level".
(
    schema: 1,
    id: "base:class:rogue",
    name: "base:text:class.rogue.name",
    hit_die: 8,
    saving_throws: (Dexterity, Intelligence),
    armor: [Light],
    weapons: [Simple],
    weapon_ids: ["base:item:longsword", "base:item:rapier", "base:item:shortsword"],
    skills: (choose: 4, from: [Acrobatics, Athletics, Deception, Insight, Intimidation, Investigation, Perception, Performance, Persuasion, SleightOfHand, Stealth]),
    starting_equipment: [("base:item:rapier", 1), ("base:item:shortbow", 1), ("base:item:arrows", 20), ("base:item:leather", 1), ("base:item:dagger", 2), ("base:item:thieves_tools", 1)],
    casting: None,
    features: [
        (level: 1, name: "base:text:class.rogue.expertise"),
        (level: 1, name: "base:text:class.rogue.sneak_attack"),
        (level: 1, name: "base:text:class.rogue.thieves_cant"),
        (level: 2, name: "base:text:class.rogue.cunning_action"),
        (level: 3, name: "base:text:class.rogue.roguish_archetype"),
        (level: 4, name: "base:text:class.rogue.ability_score_improvement"),
        (level: 5, name: "base:text:class.rogue.uncanny_dodge"),
    ],
)
