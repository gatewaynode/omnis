// The guild sells the wizard's spells (PRD §8.2: guilds and temples sell spells); cantrips come
// with the class. A spell off the buyer's class list is refused.
(
    schema: 1,
    id: "base:service:guild",
    name: "base:text:service.guild.name",
    kind: Guild,
    spells: ["base:spell:burning_hands", "base:spell:magic_missile", "base:spell:shield"],
)
