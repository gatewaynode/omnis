    schema: 1,
    id: "base:service:tavern",
    name: "base:text:service.tavern.name",
    kind: Tavern,
    rumors: [
        (text: "base:text:rumor.rats", at: 0),
        // Two days in.
        (text: "base:text:rumor.bones", at: 2880),
        // Ten days in.
        (text: "base:text:rumor.goblins", at: 14400),
    ],
)
