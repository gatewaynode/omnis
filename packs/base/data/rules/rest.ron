// Resting (PRD §8.2, SRD 5.1): a short rest is an hour and spends hit dice; a long rest is
// eight hours, costs food, restores fully, may be ambushed, and comes at most once a day.
// The ambush chance starts at the map's random-encounter chance; M7 step 5 measures it.
(
    schema: 1,
    id: "base:rules:rest",
    slots: {
        "rest.ambush_chance": (inputs: ["map_chance"], expr: "map_chance"),
    },
    values: {
        "short_rest_minutes": 60,
        "long_rest_minutes": 480,
        "long_rest_every_minutes": 1440,
        "rest_food_per_member": 1,
        "rest_ambush_surprise": 0,
    },
)
