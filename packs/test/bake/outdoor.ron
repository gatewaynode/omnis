// Bake spec for the outdoor tileset: `omnis-cli tileset bake packs/test/bake/outdoor.ron`.
// Sheet coordinates are the top-left pixel of a 16x16 tile in the OpenRTP exterior chipset.
(
    sheet: "../../../assets/openrtp-tiles/exterior.png",
    tile_size: 16,
    tileset_id: "test:tileset:outdoor",
    name: "outdoor",
    viewport: (960, 540),
    texel_scale: 4,
    detail_depth: 4,
    width: 3,
    surfaces: {
        "grass": (kind: Floor, tile: (16, 144)),
        "road": (kind: Floor, tile: (16, 224)),
        "trees": (kind: Block, tile: (64, 160)),
        "water": (kind: Floor, tile: (0, 64)),
        "hedge": (kind: WallFront, tile: (208, 16)),
        "hedge.left": (kind: WallLeft, tile: (208, 16)),
        "hedge.right": (kind: WallRight, tile: (208, 16)),
        "gate": (kind: Door, tile: (208, 96)),
        "gate.open": (kind: DoorFrame, tile: (208, 16)),
        // Portal markers from the pink object area: the stairway down (2x2 tiles at
        // (448, 128)) and the wooden signpost for roads between maps (one tile at (320, 224)).
        "stairs.down": (kind: Object, tile: (448, 128), size: (2, 2)),
        "signpost": (kind: Object, tile: (320, 224)),
    },
    // The object area's background, palette pink; the sheet has no alpha.
    key: Some((0xff, 0x67, 0x8b)),
)
