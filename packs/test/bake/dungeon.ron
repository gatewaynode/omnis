// Bake spec for the dungeon tileset: `omnis-cli tileset bake packs/test/bake/dungeon.ron`.
// Sheet coordinates are the top-left pixel of a 16x16 tile in the OpenRTP dungeon chipset.
(
    sheet: "../../../assets/openrtp-tiles/dungeon.png",
    tile_size: 16,
    tileset_id: "test:tileset:dungeon",
    name: "dungeon",
    viewport: (960, 540),
    texel_scale: 4,
    detail_depth: 6,
    width: 5,
    surfaces: {
        "floor": (kind: Floor, tile: (192, 48)),
        "ceiling": (kind: Ceiling, tile: (192, 64)),
        "wall": (kind: WallFront, tile: (192, 0)),
        "wall.left": (kind: WallLeft, tile: (192, 0)),
        "wall.right": (kind: WallRight, tile: (192, 0)),
        "door": (kind: Door, tile: (240, 32)),
        "door.open": (kind: DoorFrame, tile: (192, 0)),
        "rock": (kind: Block, tile: (240, 0)),
        // Portal marker: the stone stairway in the pink object area, 2x2 tiles at (384, 224).
        "stairs.up": (kind: Object, tile: (384, 224), size: (2, 2)),
    },
    // The object area's background, palette pink; the sheet has no alpha.
    key: Some((0xff, 0x67, 0x8b)),
)
