// A 12x5 town: a street with seven services behind doors, four to the north and three to the
// south, a green at the south-east corner, and the road out to the meadow at the east end.
// Each service's rooms have their own terrain so the automap tells them apart; the site is the
// tile just inside the door. Layout format: crates/omnis-data/src/map.rs module docs.
(
    schema: 1,
    id: "test:map:town",
    name: "test:text:map.town.name",
    kind: Town,
    tileset: "test:tileset:outdoor",
    width: 12,
    height: 5,
    start: (10, 2, West),
    wall: (front: "hedge", left: "hedge.left", right: "hedge.right"),
    door: "gate",
    door_open: Some("gate.open"),
    terrains: [
        (glyph: 'r', name: "street", floor: "road", ceiling: None, passable: true, color: (150, 120, 80), visibility_depth: 12, step_minutes: 1),
        (glyph: ',', name: "green", floor: "grass", ceiling: None, passable: true, color: (70, 140, 60), visibility_depth: 12, step_minutes: 1),
        (glyph: 'I', name: "inn", floor: "road", ceiling: None, passable: true, color: (170, 110, 60), visibility_depth: 4, step_minutes: 1),
        (glyph: 'E', name: "temple", floor: "road", ceiling: None, passable: true, color: (220, 210, 170), visibility_depth: 4, step_minutes: 1),
        (glyph: 'K', name: "trainer", floor: "road", ceiling: None, passable: true, color: (170, 60, 50), visibility_depth: 4, step_minutes: 1),
        (glyph: 'G', name: "guild", floor: "road", ceiling: None, passable: true, color: (110, 80, 180), visibility_depth: 4, step_minutes: 1),
        (glyph: 'S', name: "smith", floor: "road", ceiling: None, passable: true, color: (90, 90, 100), visibility_depth: 4, step_minutes: 1),
        (glyph: 'V', name: "tavern", floor: "road", ceiling: None, passable: true, color: (200, 150, 40), visibility_depth: 4, step_minutes: 1),
        (glyph: 'B', name: "bank", floor: "road", ceiling: None, passable: true, color: (60, 130, 140), visibility_depth: 4, step_minutes: 1),
    ],
    layout: [
        "+-+-+-+-+-+-+-+-+-+-+-+-+",
        "|I I I|E E E|K K K|G G G|",
        "+ + + + + + + + + + + + +",
        "|I I I|E E E|K K K|G G G|",
        "+-+=+-+-+=+-+-+=+-+-+=+-+",
        "|r r r r r r r r r r r r|",
        "+-+=+-+-+=+-+-+=+-+ + + +",
        "|S S S|V V V|B B B|, , ,|",
        "+ + + + + + + + + + + + +",
        "|S S S|V V V|B B B|, , ,|",
        "+-+-+-+-+-+-+-+-+-+-+-+-+",
    ],
    portals: [
        (x: 11, y: 2, to_map: "test:map:meadow", to_x: 16, to_y: 16, to_facing: North, marker: Some("signpost")),
    ],
    sites: [
        (x: 1, y: 1, service: "base:service:inn"),
        (x: 4, y: 1, service: "base:service:temple"),
        (x: 7, y: 1, service: "base:service:trainer"),
        (x: 10, y: 1, service: "base:service:guild"),
        (x: 1, y: 3, service: "base:service:smith"),
        (x: 4, y: 3, service: "base:service:tavern"),
        (x: 7, y: 3, service: "base:service:bank"),
    ],
)
