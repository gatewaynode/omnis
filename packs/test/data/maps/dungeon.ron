// A 24x24 dungeon: sixteen 6x6 rooms, doors between most of them, a few pillars.
// Layout format: crates/omnis-data/src/map.rs module docs.
(
    schema: 1,
    id: "test:map:dungeon",
    name: "test:text:map.dungeon.name",
    kind: Dungeon,
    tileset: "test:tileset:dungeon",
    width: 24,
    height: 24,
    start: (1, 0, South),
    wall: (front: "wall", left: "wall.left", right: "wall.right"),
    door: "door",
    door_open: Some("door.open"),
    terrains: [
        (glyph: '.', name: "floor", floor: "floor", ceiling: Some("ceiling"), passable: true, color: (110, 90, 70), visibility_depth: 6, step_minutes: 1),
        (glyph: '#', name: "rock", floor: "floor", ceiling: Some("ceiling"), block: Some("rock"), passable: false, opaque: true, color: (60, 50, 45), visibility_depth: 6, step_minutes: 1),
    ],
    layout: [
        "+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+",
        "|. . . . . .|. . . . . .|. . . . . .|. . . . . .|",
        "+ + + + + + + + + + + + + + + + + + + + + + + + +",
        "|. . . . . .|. . . . . .|. . . . . .|. . . . . .|",
        "+ + + + + + + + + + + + + + + + + + + + + + + + +",
        "|. . . . . .|. . . . . .|. . . . . .|. . . . . .|",
        "+ + + + + + + + + + + + + + + + + + + + + + + + +",
        "|. . . # . .:. . . . . .|. . . . . .:. . . . . .|",
        "+ + + + + + + + + + + + + + + + + + + + + + + + +",
        "|. . . . . .|. . . . . .|. . . # . .|. . . . . .|",
        "+ + + + + + + + + + + + + + + + + + + + + + + + +",
        "|. . . . . .|. . . . . .|. . . . . .|. . . . . .|",
        "+-+-+-+=+-+-+-+-+-+=+-+-+-+-+-+=+-+-+-+-+-+=+-+-+",
        "|. . . . . .|. . . . . .|. . . . . .|. . . . . .|",
        "+ + + + + + + + + + + + + + + + + + + + + + + + +",
        "|. . . . . .|. . . . . .|. . . . . .|. . . . . .|",
        "+ + + + + + + + + + + + + + + + + + + + + + + + +",
        "|. . . . . .|. . # . . .|. . . . . .|. . . . . .|",
        "+ + + + + + + + + + + + + + + + + + + + + + + + +",
        "|. . . . . .:. . . . . .:. . . . . .:. . . . . .|",
        "+ + + + + + + + + + + + + + + + + + + + + + + + +",
        "|. . . . . .|. . . . . .|. . . . . .|. . . . . .|",
        "+ + + + + + + + + + + + + + + + + + + + + + + + +",
        "|. . . . . .|. . . . . .|. . . . . .|. . . . . .|",
        "+-+-+-+=+-+-+-+-+-+-+-+-+-+-+-+=+-+-+-+-+-+=+-+-+",
        "|. . . . . .|. . . . . .|. . . . . .|. . . . . .|",
        "+ + + + + + + + + + + + + + + + + + + + + + + + +",
        "|. . . . . .|. . . . . .|. . . . . .|. . . . . .|",
        "+ + + + + + + + + + + + + + + + + + + + + + + + +",
        "|. . . . . .|. . . . . .|. . # . . .|. . . . . .|",
        "+ + + + + + + + + + + + + + + + + + + + + + + + +",
        "|. . . . . .:. . . # . .:. . . . . .|. . . . . .|",
        "+ + + + + + + + + + + + + + + + + + + + + + + + +",
        "|. . . . . .|. . . . . .|. . . . . .|. . . . . .|",
        "+ + + + + + + + + + + + + + + + + + + + + + + + +",
        "|. . . . . .|. . . . . .|. . . . . .|. . . . . .|",
        "+-+-+-+-+-+-+-+-+-+=+-+-+-+-+-+=+-+-+-+-+-+=+-+-+",
        "|. . . . . .|. . . . . .|. . . . . .|. . . . . .|",
        "+ + + + + + + + + + + + + + + + + + + + + + + + +",
        "|. . . . . .|. . . . . .|. . . . . .|. . . . . .|",
        "+ + + + + + + + + + + + + + + + + + + + + + + + +",
        "|. . . . . .|. . . . . .|. . . . . .|. . # . . .|",
        "+ + + + + + + + + + + + + + + + + + + + + + + + +",
        "|. . . . . .|. . . . . .:. . . . . .:. . . . . .|",
        "+ + + + + + + + + + + + + + + + + + + + + + + + +",
        "|. . . . . .|. . . . . .|. . . . . .|. . . . . .|",
        "+ + + + + + + + + + + + + + + + + + + + + + + + +",
        "|. . . . . .|. . . . . .|. . . . . .|. . . . . .|",
        "+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+",
    ],
    portals: [
        (x: 0, y: 0, to_map: "test:map:meadow", to_x: 16, to_y: 6, to_facing: South),
    ],
    // Placed groups in the second row of rooms, rats only until the fight systems have been
    // played (owner, 2026-09-13): the pair the M4 acceptance clears (from the start: forward
    // x5, turn left, forward x2, turn right, use, forward x3), a wary one that comes back, and
    // a friendly one. A small random table of rats on top.
    encounters: [
        (x: 3, y: 8, stacks: [("test:monster:giant_rat", 2)], disposition: Hostile, once: true),
        (x: 9, y: 8, stacks: [("test:monster:giant_rat", 1)], disposition: Wary),
        (x: 15, y: 8, stacks: [("test:monster:giant_rat", 1)], disposition: Friendly, once: true),
    ],
    random: Some((
        chance_percent: 3,
        entries: [
            (weight: 3, stacks: [("test:monster:giant_rat", (count: 1, sides: 2, modifier: 0))]),
            (weight: 1, stacks: [("test:monster:giant_rat", (count: 1, sides: 1, modifier: 0))], disposition: Wary),
        ],
    )),
)
